{
  "$defs": {
    "DeviceFrame": {
      "description": "Frames a device sends over the connection it dialled.",
      "oneOf": [
        {
          "description": "The first frame after connecting: who the device is, its credential,\nand what it can run. The gateway answers with `GatewayFrame::Welcome`\nor `GatewayFrame::Rejected` and closes.",
          "properties": {
            "capabilities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "device_id": {
              "type": "string"
            },
            "kind": {
              "const": "hello",
              "type": "string"
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "shared_token": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "device_id",
            "shared_token",
            "capabilities"
          ],
          "type": "object"
        },
        {
          "description": "Sent every `heartbeat_interval_secs` from the welcome; the gateway\nmarks a device stale when they stop and disconnected when the\nconnection closes.",
          "properties": {
            "kind": {
              "const": "heartbeat",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The operation `correlation_id` finished with `output`.",
          "properties": {
            "correlation_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "result",
              "type": "string"
            },
            "output": true
          },
          "required": [
            "kind",
            "correlation_id",
            "output"
          ],
          "type": "object"
        },
        {
          "description": "The operation `correlation_id` failed on the device.",
          "properties": {
            "correlation_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "failure",
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "correlation_id",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "The operation `correlation_id` was stopped at the gateway's request.",
          "properties": {
            "correlation_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "correlation_id"
          ],
          "type": "object"
        }
      ]
    },
    "DeviceListResponse": {
      "properties": {
        "devices": {
          "items": {
            "$ref": "#/$defs/DeviceResponse"
          },
          "type": "array"
        }
      },
      "required": [
        "devices"
      ],
      "type": "object"
    },
    "DeviceResponse": {
      "description": "A registered device as the gateway lists it. `capabilities` are what the\ndevice last advertised on connecting; empty until it first dials in.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "device_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "registered_at": {
          "format": "date-time",
          "type": "string"
        },
        "workspace_root": {
          "type": "string"
        },
        "workspace_roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "device_id",
        "kind",
        "workspace_root",
        "workspace_roots",
        "capabilities",
        "registered_at"
      ],
      "type": "object"
    },
    "GatewayFrame": {
      "description": "Frames the gateway sends to a connected device.",
      "oneOf": [
        {
          "description": "The hello was accepted; the device is connected.",
          "properties": {
            "device_id": {
              "type": "string"
            },
            "heartbeat_interval_secs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "device_id",
            "heartbeat_interval_secs"
          ],
          "type": "object"
        },
        {
          "description": "The hello was refused; the gateway closes after this frame.",
          "properties": {
            "kind": {
              "const": "rejected",
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "Run `tool_name` with `params` in `context`, answering with a\n`Result`, `Failure`, or `Cancelled` frame carrying `correlation_id`.",
          "properties": {
            "context": {
              "$ref": "#/$defs/SerializableToolContext"
            },
            "correlation_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "operation",
              "type": "string"
            },
            "params": true,
            "tool_name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "correlation_id",
            "tool_name",
            "params",
            "context"
          ],
          "type": "object"
        },
        {
          "description": "Stop the operation `correlation_id` if it is still running; the\ndevice answers `Cancelled`, or `Result`/`Failure` if it had already\nfinished.",
          "properties": {
            "correlation_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "cancel",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "correlation_id"
          ],
          "type": "object"
        }
      ]
    },
    "RegisterDeviceRequest": {
      "description": "Register a device: its identity, the secret its connection credential\nresolves against, and the workspace it may operate in. What it can run\nis not registered — the device advertises that each time it connects.",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "kind": {
          "default": "attached_device",
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "shared_token_secret_ref": {
          "description": "The gateway secret whose value the device presents as its shared\ntoken when it connects.",
          "type": "string"
        },
        "workspace_root": {
          "type": "string"
        },
        "workspace_roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "device_id",
        "shared_token_secret_ref",
        "workspace_root"
      ],
      "type": "object"
    },
    "SerializableToolContext": {
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "turn_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "user_info": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "session_id",
        "working_directory",
        "allowed_paths"
      ],
      "type": "object"
    },
    "UserInfo": {
      "properties": {
        "id": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "metadata"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "device_frame": {
      "$ref": "#/$defs/DeviceFrame"
    },
    "gateway_frame": {
      "$ref": "#/$defs/GatewayFrame"
    },
    "list": {
      "$ref": "#/$defs/DeviceListResponse"
    },
    "register": {
      "$ref": "#/$defs/RegisterDeviceRequest"
    }
  },
  "required": [
    "register",
    "list",
    "device_frame",
    "gateway_frame"
  ],
  "title": "DeviceSurface",
  "type": "object"
}

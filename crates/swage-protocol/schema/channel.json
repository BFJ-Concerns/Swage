{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChannelSurface",
  "type": "object",
  "properties": {
    "delivery_log": {
      "$ref": "#/$defs/DeliveryLogResponse"
    },
    "delivery_log_query": {
      "$ref": "#/$defs/DeliveryLogQuery"
    },
    "dm_inbound": {
      "$ref": "#/$defs/DevDmInboundRequest"
    },
    "inbound_response": {
      "$ref": "#/$defs/ChannelInboundResponse"
    },
    "status": {
      "$ref": "#/$defs/ChannelStatusListResponse"
    },
    "thread_inbound": {
      "$ref": "#/$defs/DevThreadInboundRequest"
    }
  },
  "required": [
    "dm_inbound",
    "thread_inbound",
    "inbound_response",
    "delivery_log_query",
    "delivery_log",
    "status"
  ],
  "$defs": {
    "ChannelInboundResponse": {
      "type": "object",
      "properties": {
        "delivered_to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeliveryTarget"
          }
        },
        "queued": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueuedMessageView"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "session_id",
        "delivered_to",
        "response"
      ]
    },
    "ChannelStatusListResponse": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelStatusResponse"
          }
        }
      },
      "required": [
        "channels"
      ]
    },
    "ChannelStatusResponse": {
      "type": "object",
      "properties": {
        "delivery_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "integration": {
          "type": "string"
        },
        "last_delivery_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "route_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "integration",
        "status",
        "route_count",
        "delivery_count"
      ]
    },
    "DeliveryLogQuery": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "session_id"
      ]
    },
    "DeliveryLogResponse": {
      "type": "object",
      "properties": {
        "deliveries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordedDelivery"
          }
        }
      },
      "required": [
        "deliveries"
      ]
    },
    "DeliveryRoutingRequest": {
      "description": "Where output should be routed once a run completes.\n\n`deliver_to_origin` defaults to true for channel-initiated turns, where\nan origin always exists. Callers without an origin (schedules, manual\nAPI calls) must set it false or target resolution errors.",
      "type": "object",
      "properties": {
        "deliver_to_origin": {
          "type": "boolean",
          "default": true
        },
        "explicit_targets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DeliveryTarget"
          }
        },
        "home_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "store_local_output": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "DeliveryTarget": {
      "description": "A destination for a run's output.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "account": {
              "type": "string"
            },
            "conversation": {
              "type": "string"
            },
            "integration": {
              "$ref": "#/$defs/ExternalChannelIntegration"
            },
            "kind": {
              "type": "string",
              "const": "channel"
            }
          },
          "required": [
            "kind",
            "integration",
            "account",
            "conversation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local_storage"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "surface"
            },
            "surface_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "surface_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "webhook"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ]
        }
      ]
    },
    "DevDmInboundRequest": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "routing": {
          "$ref": "#/$defs/DeliveryRoutingRequest",
          "default": {
            "deliver_to_origin": true,
            "explicit_targets": [],
            "home_target": null,
            "store_local_output": false
          }
        },
        "text": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "account",
        "user_id",
        "text"
      ]
    },
    "DevThreadInboundRequest": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "routing": {
          "$ref": "#/$defs/DeliveryRoutingRequest",
          "default": {
            "deliver_to_origin": true,
            "explicit_targets": [],
            "home_target": null,
            "store_local_output": false
          }
        },
        "text": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "account",
        "channel_id",
        "thread_id",
        "text"
      ]
    },
    "ExternalChannelIntegration": {
      "description": "An external channel integration that can receive delivered output.",
      "type": "string",
      "enum": [
        "dev_dm",
        "dev_thread",
        "telegram"
      ]
    },
    "MessageAttachment": {
      "description": "Something submitted beside a message's text and carried to the model as\nits own content part. The tag names what the attachment is; a client\nsends only kinds the gateway's configured provider can consume, and the\ngateway refuses the turn otherwise rather than dropping the part.",
      "oneOf": [
        {
          "description": "An image the model reads, addressed by URL — `https://` or a\n`data:` URL carrying the bytes inline.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image_url"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ]
        }
      ]
    },
    "MessageOrigin": {
      "description": "Who put a message into the conversation. `role` is what the model is\nshown; the origin is the authorship fact a person reads — only a `User`\nmessage was typed by them, whatever role carries it to the provider.",
      "oneOf": [
        {
          "description": "A person typed it, at any client (the web UI, a channel, the API).",
          "type": "string",
          "const": "user"
        },
        {
          "description": "The model's reply.",
          "type": "string",
          "const": "assistant"
        },
        {
          "description": "A tool's result, recorded as its own row.",
          "type": "string",
          "const": "tool"
        },
        {
          "description": "The delegation machinery: a brief handed to a child, or a child's\ncompletion notice delivered to its parent.",
          "type": "string",
          "const": "delegation"
        },
        {
          "description": "A schedule's run: a fresh run's opening or a continuation's brief.",
          "type": "string",
          "const": "schedule"
        },
        {
          "description": "A workflow script's prompt to a worker.",
          "type": "string",
          "const": "workflow"
        },
        {
          "description": "A notice the platform itself attached to the conversation.",
          "type": "string",
          "const": "platform"
        }
      ]
    },
    "QueuedMessageView": {
      "description": "A message held behind a running turn: not yet a message of the\nconversation, but shown to every open view until the next turn takes it.",
      "type": "object",
      "properties": {
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessageAttachment"
          }
        },
        "client_id": {
          "description": "Identifies the client's optimistic send, when supplied.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/MessageOrigin"
        },
        "queued_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "origin",
        "content",
        "queued_at"
      ]
    },
    "RecordedDelivery": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "delivered_at": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "target": {
          "$ref": "#/$defs/DeliveryTarget"
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "session_id",
        "target",
        "content",
        "delivered_at"
      ]
    }
  }
}

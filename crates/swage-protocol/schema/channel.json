{
  "$defs": {
    "ChannelInboundResponse": {
      "properties": {
        "delivered_to": {
          "items": {
            "$ref": "#/$defs/DeliveryTarget"
          },
          "type": "array"
        },
        "response": {
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "delivered_to",
        "response"
      ],
      "type": "object"
    },
    "ChannelStatusListResponse": {
      "properties": {
        "channels": {
          "items": {
            "$ref": "#/$defs/ChannelStatusResponse"
          },
          "type": "array"
        }
      },
      "required": [
        "channels"
      ],
      "type": "object"
    },
    "ChannelStatusResponse": {
      "properties": {
        "delivery_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "integration": {
          "type": "string"
        },
        "last_delivery_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "route_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "integration",
        "status",
        "route_count",
        "delivery_count"
      ],
      "type": "object"
    },
    "DeliveryLogQuery": {
      "properties": {
        "session_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "DeliveryLogResponse": {
      "properties": {
        "deliveries": {
          "items": {
            "$ref": "#/$defs/RecordedDelivery"
          },
          "type": "array"
        }
      },
      "required": [
        "deliveries"
      ],
      "type": "object"
    },
    "DeliveryRoutingRequest": {
      "description": "Where output should be routed once a run completes.\n\n`deliver_to_origin` defaults to true for channel-initiated turns, where\nan origin always exists. Callers without an origin (schedules, manual\nAPI calls) must set it false or target resolution errors.",
      "properties": {
        "deliver_to_origin": {
          "default": true,
          "type": "boolean"
        },
        "explicit_targets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeliveryTarget"
          },
          "type": "array"
        },
        "home_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "store_local_output": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "DeliveryTarget": {
      "description": "A destination for a run's output.",
      "oneOf": [
        {
          "properties": {
            "account": {
              "type": "string"
            },
            "conversation": {
              "type": "string"
            },
            "integration": {
              "$ref": "#/$defs/ExternalChannelIntegration"
            },
            "kind": {
              "const": "channel",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "integration",
            "account",
            "conversation"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "local_storage",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "surface",
              "type": "string"
            },
            "surface_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "surface_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "webhook",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "type": "object"
        }
      ]
    },
    "DevDmInboundRequest": {
      "properties": {
        "account": {
          "type": "string"
        },
        "routing": {
          "$ref": "#/$defs/DeliveryRoutingRequest",
          "default": {
            "deliver_to_origin": true,
            "explicit_targets": [],
            "home_target": null,
            "store_local_output": false
          }
        },
        "text": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      },
      "required": [
        "account",
        "user_id",
        "text"
      ],
      "type": "object"
    },
    "DevThreadInboundRequest": {
      "properties": {
        "account": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "routing": {
          "$ref": "#/$defs/DeliveryRoutingRequest",
          "default": {
            "deliver_to_origin": true,
            "explicit_targets": [],
            "home_target": null,
            "store_local_output": false
          }
        },
        "text": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "account",
        "channel_id",
        "thread_id",
        "text"
      ],
      "type": "object"
    },
    "ExternalChannelIntegration": {
      "description": "An external channel integration that can receive delivered output.",
      "enum": [
        "dev_dm",
        "dev_thread",
        "telegram"
      ],
      "type": "string"
    },
    "RecordedDelivery": {
      "properties": {
        "content": {
          "type": "string"
        },
        "delivered_at": {
          "format": "date-time",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "format": "uuid",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/DeliveryTarget"
        },
        "turn_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "session_id",
        "target",
        "content",
        "delivered_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "delivery_log": {
      "$ref": "#/$defs/DeliveryLogResponse"
    },
    "delivery_log_query": {
      "$ref": "#/$defs/DeliveryLogQuery"
    },
    "dm_inbound": {
      "$ref": "#/$defs/DevDmInboundRequest"
    },
    "inbound_response": {
      "$ref": "#/$defs/ChannelInboundResponse"
    },
    "status": {
      "$ref": "#/$defs/ChannelStatusListResponse"
    },
    "thread_inbound": {
      "$ref": "#/$defs/DevThreadInboundRequest"
    }
  },
  "required": [
    "dm_inbound",
    "thread_inbound",
    "inbound_response",
    "delivery_log_query",
    "delivery_log",
    "status"
  ],
  "title": "ChannelSurface",
  "type": "object"
}

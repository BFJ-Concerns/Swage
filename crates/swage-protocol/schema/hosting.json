    "SandboxPolicy": {
      "description": "Per-turn sandbox policy and timeouts.\n\nSerialised to the sandboxed child, which applies the write set and the\nbroad read through Landlock; the host applies the same policy through\nbubblewrap's mounts, where the masks and the read-only paths are enforced.",
      "type": "object",
      "properties": {
        "environment": {
          "description": "Host-selected environment inherited by sandboxed commands.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "llm_request_timeout": {
          "description": "Per-LLM-request IPC timeout.",
          "$ref": "#/$defs/Duration"
        },
        "masked_paths": {
          "description": "Private paths hidden from the sandbox altogether. A directory reads as\nempty; a file reads as empty. Enforced by the mount layer, so the\nfallback backend cannot honour them.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_only_paths": {
          "description": "Paths kept read-only even where a write path above them would allow\nwriting: a read-only attachment inside a writable tree, say.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shutdown_grace_period": {
          "description": "Time to wait for graceful shutdown before SIGKILL.",
          "$ref": "#/$defs/Duration"
        },
        "tool_call_timeout": {
          "description": "Per-tool-call IPC timeout.",
          "$ref": "#/$defs/Duration"
        },
        "working_directory": {
          "description": "The directory the agent's commands run in. Writable only when it is\nalso in `write_paths`.",
          "type": "string"
        },
        "write_paths": {
          "description": "Paths the sandboxed process may write. Everything else it can see is\nread-only.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "working_directory",
        "write_paths",
        "read_only_paths",
        "masked_paths",
        "environment",
        "shutdown_grace_period",
        "tool_call_timeout",
        "llm_request_timeout"
      ]
    },
    "Schedule": {
      "description": "A schedule as returned by the API.",
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "creator": {
          "description": "Where this schedule came from — a person or an agent.",
          "$ref": "#/$defs/ScheduleCreator"
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/GateConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate_warnings": {
          "description": "Declaration-time flags on the gate, derived from it as stored; empty\nwhen there is no gate or nothing to flag.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateWarning"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "last_run_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "message": {
          "type": "string"
        },
        "next_run_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "routing": {
          "$ref": "#/$defs/DeliveryRoutingRequest"
        },
        "session": {
          "$ref": "#/$defs/SessionPolicy"
        },
        "spec": {
          "$ref": "#/$defs/ScheduleSpec"
        },
        "status": {
          "$ref": "#/$defs/ScheduleStatus"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "message",
        "status",
        "spec",
        "session",
        "creator",
        "routing",
        "created_at",
        "updated_at"
      ]
    },
    "ScheduleCreator": {
      "description": "Who created a schedule.\n\nThis is provenance, not a request field: the surface that creates the\nschedule stamps it (the settings UI and HTTP surface stamp `user`; the\nscheduling tools stamp `agent`), so an agent cannot claim a schedule was\na person's. It answers the audit question \"where did this schedule come\nfrom\" wherever schedules are listed.",
      "oneOf": [
        {
          "description": "A person, through the settings automation panel or the HTTP surface.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "An agent, through the scheduling tools. Carries the id of the agent\nthat made it.",
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "required": [
            "kind",
            "agent_id"
          ]
        }
      ]
    },
    "ScheduleListResponse": {
      "type": "object",
      "properties": {
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Schedule"
          }
        }
      },
      "required": [
        "schedules"
      ]
    },
    "ScheduleSpec": {
      "description": "When a schedule fires.\n\n- `one_shot` — a single RFC 3339 instant.\n- `interval` — natural-language `\"every N seconds|minutes|hours|days\"`.\n- `cron` — a cron expression (seconds-resolution, as parsed by the\n  `cron` crate).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "one_shot"
            }
          },
          "required": [
            "kind",
            "at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "every": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "interval"
            }
          },
          "required": [
            "kind",
            "every"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cron": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "cron"
            }
          },
          "required": [
            "kind",
            "cron"
          ]
        }
      ]
    },
    "ScheduleStatus": {
      "description": "Lifecycle status of a schedule definition.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "active",
            "paused"
          ]
        },
        {
          "description": "A one-shot that has fired, or an interval/cron with no next\noccurrence.",
          "type": "string",
          "const": "completed"
        }
      ]
    },
    "SessionPolicy": {
      "description": "Which session each run executes in.\n\n- `fresh` — every run creates a new session in the selected topic, or\n  the general scope when `topic_id` is absent, for\n  `agent_id`, with a deliberately assembled opening context (the\n  schedule's message plus the previous run's outcome).\n- `continuation` — every run continues the named session, executing as\n  whatever agent that session has at run time.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string"
            },
            "policy": {
              "type": "string",
              "const": "fresh"
            },
            "topic_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          "required": [
            "policy",
            "agent_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "continuation"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "policy",
            "session_id"
          ]
        }
      ]
    },
    "UpdateAgentDefinitionRequest": {
      "description": "Whole replacement supplied when updating a durable agent definition.",
      "type": "object",

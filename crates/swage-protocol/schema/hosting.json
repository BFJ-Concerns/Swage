{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostingSurface",
  "type": "object",
  "properties": {
    "agent_definition_create": {
      "$ref": "#/$defs/CreateAgentDefinitionRequest"
    },
    "agent_definition_list": {
      "$ref": "#/$defs/AgentDefinitionListResponse"
    },
    "agent_definition_mutation": {
      "$ref": "#/$defs/AgentDefinitionMutationResponse"
    },
    "agent_definition_scope": {
      "$ref": "#/$defs/AgentDefinitionScopeQuery"
    },
    "agent_definition_update": {
      "$ref": "#/$defs/UpdateAgentDefinitionRequest"
    },
    "approval_decision": {
      "$ref": "#/$defs/ApprovalDecisionRequest"
    },
    "approvals": {
      "$ref": "#/$defs/ApprovalListResponse"
    },
    "audit_events": {
      "$ref": "#/$defs/AuditEventListResponse"
    },
    "devices": {
      "$ref": "#/$defs/DeviceListResponse"
    },
    "effective_agent_definition_list": {
      "$ref": "#/$defs/EffectiveAgentDefinitionListResponse"
    },
    "git_credential_request": {
      "$ref": "#/$defs/GitCredentialRequest"
    },
    "git_credential_response": {
      "$ref": "#/$defs/GitCredentialResponse"
    },
    "git_sign_request": {
      "$ref": "#/$defs/GitSignRequest"
    },
    "git_sign_response": {
      "$ref": "#/$defs/GitSignResponse"
    },
    "knowledge_mirror": {
      "$ref": "#/$defs/KnowledgeMirrorRegenerateResponse"
    },
    "operator_history": {
      "$ref": "#/$defs/OperatorHistoryResponse"
    },
    "operator_overview": {
      "$ref": "#/$defs/OperatorOverviewResponse"
    },
    "presence": {
      "$ref": "#/$defs/PresenceSnapshotResponse"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxPolicy"
    }
  },
  "required": [
    "sandbox",
    "git_credential_request",
    "git_credential_response",
    "git_sign_request",
    "git_sign_response",
    "presence",
    "approvals",
    "approval_decision",
    "operator_overview",
    "operator_history",
    "audit_events",
    "agent_definition_scope",
    "agent_definition_list",
    "effective_agent_definition_list",
    "agent_definition_create",
    "agent_definition_update",
    "agent_definition_mutation",
    "devices",
    "knowledge_mirror"
  ],
  "$defs": {
    "AgentDefinitionListResponse": {
      "type": "object",
      "properties": {
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentDefinitionResponse"
          }
        }
      },
      "required": [
        "definitions"
      ]
    },
    "AgentDefinitionMutationResponse": {
      "description": "The outcome of an agent-definition mutation. The full account of the\nchange — prior and new state under a named action — lives in the audit\ntrail.",
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "topic_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "agent_id",
        "summary"
      ]
    },
    "AgentDefinitionResponse": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_max_retries": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "output_schema": true,
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_permissions": true,
        "topic_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "display_name",
        "description",
        "instructions",
        "skills",
        "created_at",
        "updated_at"
      ]
    },
    "AgentDefinitionScopeQuery": {
      "description": "Scope filter for durable agent-definition reads and deletes.",
      "type": "object",
      "properties": {
        "topic_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "ApprovalDecisionRequest": {
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/ApprovalDecisionValue"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/ApprovalDecisionScope",
          "default": "once"
        }
      },
      "required": [
        "decision"
      ]
    },
    "ApprovalDecisionScope": {
      "description": "How widely an approved decision should apply.",
      "type": "string",
      "enum": [
        "once",
        "session",
        "permanent",
        "permanent_global"
      ]
    },
    "ApprovalDecisionValue": {
      "description": "The human verdict on a pending approval.",
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "ApprovalListResponse": {
      "type": "object",
      "properties": {
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovalSummary"
          }
        }
      },
      "required": [
        "approvals"
      ]
    },
    "ApprovalSummary": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "timeout_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "turn_id",
        "agent_id",
        "kind",
        "prompt"
      ]
    },
    "AssemblyHistoryEntry": {
      "description": "One turn whose persisted assembly report can be opened in the context inspector.",
      "type": "object",
      "properties": {
        "assembly_name": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "topic_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "turn_id",
        "session_id",
        "topic_id",
        "recorded_at",
        "assembly_name"
      ]
    },
    "AuditEventCursor": {
      "description": "Where a page of the audit record ended, handed back for the next request\nas `before` and `before_id`.",
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "id"
      ]
    },
    "AuditEventListResponse": {
      "description": "A page of the audit record, newest first, under the filters the request\nnamed. `next_cursor` names the page after this one — absent when this\npage ends the record.",
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuditEventView"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditEventCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "events"
      ]
    },
    "AuditEventView": {
      "description": "One event of the local audit record, as recorded.",
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "entity_id": {
          "type": "string"
        },
        "entity_kind": {
          "type": "string"
        },
        "event_kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "metadata": true,
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "entity_kind",
        "entity_id",
        "event_kind",
        "summary",
        "metadata",
        "created_at"
      ]
    },
    "ChannelStatusListResponse": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChannelStatusResponse"
          }
        }
      },
      "required": [
        "channels"
      ]
    },
    "ChannelStatusResponse": {
      "type": "object",
      "properties": {
        "delivery_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "integration": {
          "type": "string"
        },
        "last_delivery_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "route_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "integration",
        "status",
        "route_count",
        "delivery_count"
      ]
    },
    "ClientPresenceResponse": {
      "type": "object",
      "properties": {
        "connected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "disconnected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_seen_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "state"
      ]
    },
    "ConfigurationHistoryEvent": {
      "description": "One durable configuration change as recorded at the mutation boundary.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "new_state": true,
        "prior_state": true,
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "resource_id": {
          "type": "string"
        },
        "resource_kind": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "resource_kind",
        "resource_id",
        "action",
        "source",
        "prior_state",
        "new_state",
        "recorded_at"
      ]
    },
    "CreateAgentDefinitionRequest": {
      "description": "Whole definition supplied when creating a durable agent.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_max_retries": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "output_schema": true,
        "skills": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "tool_permissions": true,
        "topic_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "display_name",
        "description",
        "instructions"
      ]
    },
    "DeliveryRoutingRequest": {
      "description": "Where output should be routed once a run completes.\n\n`deliver_to_origin` defaults to true for channel-initiated turns, where\nan origin always exists. Callers without an origin (schedules, manual\nAPI calls) must set it false or target resolution errors.",
      "type": "object",
      "properties": {
        "deliver_to_origin": {
          "type": "boolean",
          "default": true
        },
        "explicit_targets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DeliveryTarget"
          }
        },
        "home_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "store_local_output": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "DeliveryTarget": {
      "description": "A destination for a run's output.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "account": {
              "type": "string"
            },
            "conversation": {
              "type": "string"
            },
            "integration": {
              "$ref": "#/$defs/ExternalChannelIntegration"
            },
            "kind": {
              "type": "string",
              "const": "channel"
            }
          },
          "required": [
            "kind",
            "integration",
            "account",
            "conversation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local_storage"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "surface"
            },
            "surface_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "surface_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "webhook"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ]
        }
      ]
    },
    "DeviceListResponse": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceResponse"
          }
        }
      },
      "required": [
        "devices"
      ]
    },
    "DevicePresenceResponse": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "disconnected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "stale_after_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "state",
        "registered_at",
        "last_seen_at",
        "stale_after_secs"
      ]
    },
    "DeviceResponse": {
      "description": "A registered device as the gateway lists it. `capabilities` are what the\ndevice last advertised on connecting; empty until it first dials in.",
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "device_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "workspace_root": {
          "type": "string"
        },
        "workspace_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "device_id",
        "kind",
        "workspace_root",
        "workspace_roots",
        "capabilities",
        "registered_at"
      ]
    },
    "Duration": {
      "type": "object",
      "properties": {
        "nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "secs",
        "nanos"
      ]
    },
    "EffectiveAgentDefinitionListResponse": {
      "type": "object",
      "properties": {
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectiveAgentDefinitionResponse"
          }
        }
      },
      "required": [
        "definitions"
      ]
    },
    "EffectiveAgentDefinitionResponse": {
      "description": "An agent definition available when creating a session in one topic.",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "is_builtin": {
          "type": "boolean"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_max_retries": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "output_schema": true,
        "selectable": {
          "description": "Whether the picker offers it for a new session; a platform agent that\nruns only where the platform runs it is listed but not offered.",
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_scope": {
          "$ref": "#/$defs/EffectiveAgentDefinitionSourceScope"
        },
        "tool_permissions": true
      },
      "required": [
        "id",
        "display_name",
        "description",
        "instructions",
        "skills",
        "is_builtin",
        "selectable",
        "source_scope"
      ]
    },
    "EffectiveAgentDefinitionSourceScope": {
      "description": "Where an effective agent definition comes from.",
      "type": "string",
      "enum": [
        "built_in",
        "global",
        "topic"
      ]
    },
    "ExternalChannelIntegration": {
      "description": "An external channel integration that can receive delivered output.",
      "type": "string",
      "enum": [
        "dev_dm",
        "dev_thread",
        "telegram"
      ]
    },
    "GateConfig": {
      "description": "A cheap-model check that runs before the main model wakes.\n\nThe gate model inspects the schedule's message, the optional criteria,\nand the previous run's outcome, then verdicts `run` or `skip`. Its\ndecision and reasoning are recorded on the run.",
      "type": "object",
      "properties": {
        "criteria": {
          "description": "What \"work needed\" means for this schedule. When absent the gate\njudges from the schedule message and previous outcome alone.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "Model id or alias from the configured model catalogue.",
          "type": "string"
        },
        "observations": {
          "description": "State the gate is shown before it decides, beyond the schedule's own\nrecord: what the criteria name. Declared here so a criterion about a\nfile is decidable against that file, and refused at declaration when\nthe schedule's session has nowhere to read it from.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GateObservation"
          }
        }
      },
      "required": [
        "model"
      ]
    },
    "GateObservation": {
      "description": "One thing a gate observes before deciding.",
      "oneOf": [
        {
          "description": "A file under the scheduled session's trusted workspace, by a path\nrelative to it: the gate sees whether it exists, its size, and its\nopening excerpt.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "GateWarning": {
      "description": "A flag raised when a gate is declared: something about the declaration\nthe operator should know before the first fire. Derived from the gate as\nstored, never persisted, so every surface that shows the schedule shows\nthe same flags.",
      "oneOf": [
        {
          "description": "Criteria were declared but nothing is observed, so a criterion about\na file or other workspace state can never be decided against that\nstate: the gate skips such a criterion and names what it did not\nobserve, rather than guessing at every fire.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unobserved_criteria"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        }
      ]
    },
    "GitCredentialRequest": {
      "description": "One HTTPS git credential lookup on the turn's private IPC socket.",
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "type": "string"
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "protocol",
        "host"
      ]
    },
    "GitCredentialResponse": {
      "description": "An absent credential makes git continue without this helper's answer.",
      "type": "object",
      "properties": {
        "password": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GitSignRequest": {
      "description": "One request to sign a git payload on the host, from the sandboxed git's\nsigning program over the turn's private IPC socket: the SSH signing\nnamespace git names (`git`), the public key git was configured with, and\nthe payload, base64-encoded.",
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        },
        "public_key": {
